{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public-innovation-provenance.v1",
  "title": "Public innovation provenance pack",
  "type": "object",
  "required": [
    "schema",
    "seed",
    "direction",
    "generated_at",
    "nodes",
    "edges",
    "public_return",
    "gaps"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "public-innovation-provenance.v1"
    },
    "seed": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "grant",
            "publication",
            "invention",
            "patent",
            "institution",
            "company",
            "product",
            "person"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "direction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "forward",
          "reverse"
        ]
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 8,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "grant",
              "recipient",
              "subrecipient",
              "person",
              "publication",
              "invention",
              "patent",
              "assignment",
              "license",
              "organization",
              "product",
              "capital_event",
              "acquisition",
              "procurement"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "type",
          "to",
          "confidence",
          "source",
          "identifier",
          "as_of"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "funds",
              "subawards",
              "employs_or_appoints",
              "acknowledges",
              "authors",
              "invents",
              "discloses",
              "matures_to",
              "continuation_of",
              "cites",
              "owned_by",
              "assigned_by",
              "assigned_to",
              "government_interest",
              "licenses",
              "options",
              "spins_out",
              "embodies",
              "sells",
              "procures",
              "acquires",
              "invests"
            ]
          },
          "confidence": {
            "enum": [
              "established",
              "corroborated",
              "inferred",
              "unresolved",
              "not-applicable"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "description": "Record id at source, or search:<system> when confidence is unresolved and no public record id exists."
          },
          "as_of": {
            "type": "string",
            "minLength": 8,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "public_return": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "finding",
          "confidence"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "Public funding",
              "Research output",
              "IP",
              "Ownership",
              "Government license",
              "Licensing",
              "Commercialization",
              "Capitalization",
              "Acquisition",
              "Government use",
              "Public access",
              "Revenue",
              "Royalty",
              "Follow-on public funding"
            ]
          },
          "finding": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "established",
              "corroborated",
              "inferred",
              "unresolved",
              "not-applicable"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hop",
          "searched",
          "would_close"
        ],
        "properties": {
          "hop": {
            "type": "string"
          },
          "searched": {
            "type": "string"
          },
          "would_close": {
            "type": "string"
          }
        }
      }
    }
  }
}
